{
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@rails/ujs": "^7.1.501",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "alpinejs": "^3.14.1",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.0.7",
    "daisyui": "^4.12.24",
    "esbuild": "^0.25.4",
    "global": "^4.4.0",
    "htmx.org": "2.0.4",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.3",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1",
    "postcss-preset-env": "^10.1.6",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "heroku-postbuild": "bun run prod",
    "build:js": "bun build src/js/app.js --outfile=public/js/app.js --sourcemap=inline --target=browser",
    "prod:js": "bun build src/js/app.js --outfile=public/js/app.js --minify --target=browser",
    "build:css": "tailwindcss --postcss --input=src/css/app.css --output=public/css/app.css",
    "watch:js": "bun build src/js/app.js --outfile=public/js/app.js --watch --sourcemap=inline --target=browser",
    "watch:css": "tailwindcss --postcss --watch --input=src/css/app.css --output=public/css/app.css",
    "dev": "bun run watch:js & bun run watch:css",
    "build": "bun run build:js && bun run build:css",
    "prod": "bun run prod:js && bun run build:css",
    "prod:css": "tailwindcss --minify --input=src/css/app.css --output=public/css/app.css"
  },
  "devDependencies": {
    "@types/node": "^20.17.47",
    "browser-sync": "^2.29.3",
    "prettier": "^3.5.3",
    "resolve-url-loader": "5.0.0",
    "tailwindcss-font-inter": "^3.1.0",
    "typescript": "^5.8.3"
  }
}
