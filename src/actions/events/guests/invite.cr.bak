class Events::Guests::Invite < BrowserAction
  include RequireEventFromId
  include RequireEventOwnership

  post "/events/:event_id/guests/invite" do
    user = UserQuery.new.email(params.get("email")).first?

    if user.nil?
      flash.failure = "User with email #{params.get("email")} not found"
      redirect Events::Show.with(event.id)
      return
    end

    # Check if already invited
    existing_guest = GuestQuery.new.for_event(event).for_user(user).first?
    if existing_guest
      flash.info = "#{user.name} is already invited to this event"
      redirect Events::Show.with(event.id)
      return
    end

    SaveGuest.create(
      user_id: user.id,
      event_id: event.id,
      status: Guest::Status::NoAnswer
    ) do |operation, guest|
      if guest
        # Send invitation email
        EventInvitationEmail.new(guest, event, current_user).deliver_now
        flash.success = "Invited #{user.name} to #{event.name}"
        redirect Events::Show.with(event.id)
      else
        flash.failure = "Failed to invite guest"
        redirect Events::Show.with(event.id)
      end
    end
  end
end